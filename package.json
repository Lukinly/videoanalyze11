{
  "name": "videoanalyze",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "test": "vitest run",
    "test:v0": "corepack pnpm test",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "dev": "corepack pnpm --parallel --filter @videoanalyze/api --filter @videoanalyze/worker --filter @videoanalyze/web dev",
    "build": "corepack pnpm -r build",
    "test:acceptance": "vitest run tests/acceptance",
    "verify:local-upload-analysis": "node scripts/verify-local-upload-analysis.mjs",
    "admin:create": "corepack pnpm --filter @videoanalyze/api admin:create"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "eslint": "^9.0.0",
    "drizzle-kit": "^0.30.0",
    "jsdom": "^26.1.0",
    "pg-mem": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
