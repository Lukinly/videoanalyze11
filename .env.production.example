# Copy to .env.production. This file contains configuration, never secret values.
# Run: node scripts/init-production-secrets.mjs
SECRETS_DIR=../.local/production-secrets
PUBLIC_HOST=https://app.example.com
STORAGE_HOST=https://media.example.com
SMTP_USER=your-sender@163.com
MAIL_FROM_NAME=十一视频笔记
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_DAILY_LIMIT=100
MAIL_RECIPIENT_DAILY_LIMIT=10
AUTH_REQUESTS_PER_MINUTE=20
S3_BUCKET=videoanalyze
# Garage region is fixed to us-east-1 in infra/storage/garage.toml.
LLM_API_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
LLM_API_MODEL=qwen3.7-flash
LLM_API_PROTOCOL=auto
# ASR reuses llm_api_key; this must be a Beijing-region Qwen/DashScope key.
ASR_API_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
ASR_MODEL=qwen3.8-omni-flash
GLOBAL_WORKER_CONCURRENCY=2
FFMPEG_CONCURRENCY=1
LONG_VIDEO_CONCURRENCY=1
MAX_TOTAL_QUEUED_RUNS=20
MAX_UPLOAD_BYTES=2000000000
# Set below available disk space; admission rejects at 80% of this logical budget.
TEMP_MEDIA_CAPACITY_BYTES=40000000000
# Bind publicly only on the reverse proxy. Override for isolated local smoke tests.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Optional server-owned proxy for API metadata and Worker downloads/model calls.
# Leave empty for direct access. Do not use a proxy running on a personal computer.
SERVER_OUTBOUND_PROXY=
# Default bypasses internal services, Bilibili, Beijing Qwen and SMTP domains.
# SERVER_NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,storage,minio,.bilibili.com,.bilivideo.com,.bilivideo.cn,.hdslb.com,.biliapi.net,.biliapi.com,.b23.tv,.aliyuncs.com,.qianwenaiapi.com,.163.com
