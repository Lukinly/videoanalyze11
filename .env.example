# Copy to .env and replace placeholders locally. Never commit the real .env.
NODE_ENV=production
GROQ_API_KEY=replace-with-server-side-groq-key
# Optional outbound proxy used only by the analysis worker.
WORKER_HTTP_PROXY=
WORKER_HTTPS_PROXY=
WORKER_NO_PROXY=postgres,redis,minio,localhost,127.0.0.1
# Optional V1 summary LLM — Anthropic-compatible chat endpoint (e.g. DeepSeek's
# https://api.deepseek.com/anthropic). Leave empty to keep transcript-only (P0).
# These names are read verbatim; uppercase LLM_API_KEY / LLM_API_BASE_URL /
# LLM_API_MODEL are also accepted.
llm_api_key=
llm_api_base_url=https://api.deepseek.com/anthropic
llm_api_model=deepseek-v4-flash
# LLM_CONTEXT_WINDOW=128000
DATABASE_URL=postgres://videoanalyze:videoanalyze@postgres:5432/videoanalyze
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
# Address used in URLs returned to the browser. Use the public MinIO/S3 address.
CADDYFILE=Caddyfile
PUBLIC_HOST=https://localhost
STORAGE_HOST=https://storage.localhost
S3_PUBLIC_ENDPOINT=https://storage.localhost
MINIO_API_CORS_ALLOW_ORIGIN=https://localhost,http://localhost
S3_REGION=us-east-1
S3_BUCKET=videoanalyze
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-in-production
MAIL_API_URL=http://mailpit:8025/api/v1/send
VERIFICATION_BASE_URL=https://your-domain.example
MAX_UPLOAD_BYTES=2000000000
TEMP_MEDIA_CAPACITY_BYTES=40000000000
MAX_VIDEO_DURATION_SECONDS=7200
MAX_ACTIVE_RUNS_PER_USER=2
GLOBAL_WORKER_CONCURRENCY=2
RETENTION_SWEEP_INTERVAL_SECONDS=900
ORIGINAL_RETENTION_DAYS=7
RESULT_RETENTION_DAYS=30
# Independent off-site database backup. Do not reuse the media-storage bucket or credentials.
BACKUP_AGE_RECIPIENT=age1replace-with-public-recipient
BACKUP_AGE_IDENTITY_FILE=/run/secrets/backup-age-identity.txt
BACKUP_S3_ENDPOINT=https://independent-backup-storage.example
BACKUP_S3_BUCKET=videoanalyze-backups
BACKUP_S3_ACCESS_KEY=replace-with-backup-only-access-key
BACKUP_S3_SECRET_KEY=replace-with-backup-only-secret-key
