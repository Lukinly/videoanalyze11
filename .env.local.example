# Native local development: pnpm local:dev (PostgreSQL 16, Redis, Mailpit required)
NODE_ENV=development
GROQ_API_KEY=
llm_api_key=
llm_api_base_url=
llm_api_model=
# auto | anthropic | openai; use openai for a generic /v1 Chat Completions URL
LLM_API_PROTOCOL=auto
DATABASE_URL=postgres://videoanalyze:videoanalyze@127.0.0.1:5433/videoanalyze
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=videoanalyze
S3_ACCESS_KEY=S3RVER
S3_SECRET_KEY=S3RVER
MAIL_API_URL=http://127.0.0.1:8025/api/v1/send
VERIFICATION_BASE_URL=http://localhost:5173
